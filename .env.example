# Copia este archivo y nómbralo .env (el .env no se sube a Git).
# Aquí va solo la configuración; las contraseñas van en la carpeta secrets/.

# Indicadores de la OMS que baja el recolector, separados por coma.
# En la demo se agrega WHS4_154 (control prenatal, 4 o más visitas).
INDICADORES=MDG_0000000026,MDG_0000000025

# Cada cuántas horas vuelve a revisar la API.
INTERVALO_HORAS=24
